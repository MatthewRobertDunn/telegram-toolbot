# Example environment file for the Telegram AI chatbot.
#
# Copy to `.env` at the project root and fill in what you need; the bot
# only requires TELEGRAM_API_TOKEN and OPENAI_API_KEY. Every variable
# below is read by src/config.py — see the README for the full table.

# --- Required -----------------------------------------------------------------
# Bot token from @BotFather (https://core.telegram.org/bots/features#botfather)
TELEGRAM_API_TOKEN=
# API key for the OpenAI-compatible chat completions endpoint. The bot
# refuses to start without it.
OPENAI_API_KEY=

# --- Chat completions ---------------------------------------------------------
# OpenAI-compatible endpoint. For NVIDIA NIM use
# https://integrate.api.nvidia.com/v1; the built-in default targets a
# private LAN host (see README).
#OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# Default chat model.
#LLM_MODEL=auto:smart
# Optional override for the model used by the `subagent` tool. Unset
# means each user's current /model setting is used.
#SUBAGENT_MODEL=
# Comma-separated list of model IDs whose chain-of-thought arrives
# inline in the content field and needs splitting out.
#THINK_SPLIT_MODELS=big-pickle
# Stream partial replies into the chat as drafts (1/true/on or 0/false/off).
#STREAM_DRAFTS=1

# --- Access control -----------------------------------------------------------
# Comma-separated Telegram user IDs allowed to use the bot. WARNING:
# when unset/misspelled the bot is open to anyone who finds it.
#ALLOWED_IDS=

# --- Storage ------------------------------------------------------------------
# Path to the SQLite database shared by memory, settings and journal.
# Default: store.db in the project root.
#STORE_DB_PATH=

# --- Image generation ---------------------------------------------------------
# NVIDIA_API_KEY falls back to OPENAI_API_KEY when unset.
#NVIDIA_API_KEY=
# AI Horde key (provider "horde"); the AI_HOARD_KEY spelling is accepted
# as an alias. The anonymous key 0000000000 works with limits.
#AI_HORDE_KEY=
#AI_HORDE_API_URL=https://aihorde.net/api/v2
# Default "nvidia-flux3" endpoint.
#IMAGE_GEN_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux-3-image-klein
# Provider "nvidia-flux2" endpoint.
#NVIDIA_FLUX2_GEN_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b
# Cloudflare Workers AI (provider "cloudflare"): disabled while empty.
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_IMAGE_MODEL=@cf/leonardo/phoenix-1.0

# --- Sandboxes ----------------------------------------------------------------
#SANDBOX_IMAGE=elpechos/toolbot-sandbox:latest
# Seconds of inactivity before a sandbox is stopped (files kept).
#SANDBOX_IDLE_STOP_TIMEOUT=3600
# Seconds since the last access before a sandbox is removed (all changes lost).
#SANDBOX_IDLE_DESTROY_TIMEOUT=86400
# Max seconds per sandbox command.
#SANDBOX_EXEC_TIMEOUT=300
# Max seconds to start a sandbox (includes image pull).
#SANDBOX_START_TIMEOUT=300
# How often idle sandboxes are checked, in seconds.
#SANDBOX_REAP_INTERVAL=60
#SANDBOX_MEMORY=1g
#SANDBOX_CPUS=8.0
#SANDBOX_PIDS_LIMIT=256

# --- Skills -------------------------------------------------------------------
# Host directory scanned for skill definitions (mounted read-only into
# sandboxes). Default: src/data/skills.
#SKILLS_DIR=
# Mount point of the skills directory inside sandboxes.
#SANDBOX_SKILLS_DIR=/skills
